          "id": "166bda64-6fca-4c9e-9b93-dcbaf8d4a5a5",
          "name": "Retrieve multi currency account eligibility",
          "request": {
            "name": "Retrieve multi currency account eligibility",
            "description": {
              "content": "Checks eligibility for a multi-currency account for either a specific profile or for a location. Customers in some countries and states/provinces may not be eligible for a multi currency account.\n\nTo check a profile, pass the `profileId` as a query parameter.\n\nTo check a specific location, pass the `country` using 2-letter ISO 3166 codes. If the country is `US`, a valid 2-letter `state` parameter must also be passed.\n\n- Example (France): `/v4/multi-currency-account/eligibility?country=FR`\n- Example (USA, California): `/v4/multi-currency-account/eligibility?country=US&state=CA`\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v4",
                "multi-currency-account",
                "eligibility"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "profileId",
                  "value": "<long>",
                  "description": "Profile ID to check eligibility for."
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "2-letter ISO 3166 country code to check eligibility for."
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "2-letter state/province code. Required when `country` is `US`."
                }
              ],
              "variable": []
