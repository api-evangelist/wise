  "item": [
    {
      "id": "7bfa6985-e9e2-4c2e-8e0b-173589f62eb4",
      "name": "sca-ott",
      "description": {
        "content": "One-time tokens are temporary authentication sessions used to track SCA challenges. When an SCA-protected endpoint is called, a one-time token is returned containing the challenges that must be completed.\n\nPlease read the [SCA over API guide](/guides/developer/auth-and-security/sca-over-api) to understand how SCA integration works.\n",
        "type": "text/plain"
      },
      "item": [
