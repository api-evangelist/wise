            "description": {
              "content": "Cases are used to collect or transmit additional information between Partners and Wise. Use this endpoint to create a new case.\n\n{% admonition type=\"warning\" %}\nPlease do not include PII in the `subject` of a case. Any specific details regarding the case that need to be communicated should be included in the `description`.\n{% /admonition %}\n",
              "type": "text/plain"
            },
            "url": {
