    {
      "id": "a72afc26-8d5c-4a7b-a104-d3b4374df269",
      "name": "sca-facemaps",
      "description": {
        "content": "Facemaps are inherence-based (biometric) SCA challenge factors that use FaceTec's 3D face recognition technology.\n\nFacemaps should be exported from your FaceTec server using their SDK's export API. Use Wise's [FaceTec public key](/api-reference/facetec/facetecpublickeyget) to encrypt the facemap during export.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1cf86349-b6fa-45ed-b40a-610ad644775e",
          "name": "Verify FaceMap",
          "request": {
            "name": "Verify FaceMap",
            "description": {
              "content": "To clear a **FACE_MAP** challenge listed in a OTT.\n\nNotes:\n1. User is required to [enrol facemap](/api-reference/user-security/usersecurityfacemapenrol) before the verification can be successful.\n2. Rate limit may be applied if there are 5 continuous unsuccessful attempts and OTT creation will be blocked for 15 minutes.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "one-time-token",
                "facemap",
